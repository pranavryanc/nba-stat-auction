  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "update-data": "node scripts/update-player-data.mjs",
    "update-history": "node scripts/update-historical-data.mjs",
    "test-positions": "node scripts/test-position-parser.mjs",
    "sanitize-positions": "node scripts/sanitize-position-data.mjs",
    "audit-positions": "node scripts/audit-position-data.mjs",
    "test": "vitest run",
